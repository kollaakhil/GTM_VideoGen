# Sign-in (required)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=   # 32+ random chars, e.g. `openssl rand -hex 32`
# QA_PASS_SCORE=8          # optional: minimum Vision QA score (1-10) for a creative to pass
# INSECURE_COOKIES=1        # optional: allow the session cookie over plain HTTP in production (local testing only)

# AI & media
OPENROUTER_API_KEY=
OPENAI_API_KEY=   # optional: openai/* models go direct to OpenAI (separate API billing)
FAL_KEY=
# Higgsfield: either HF_API_KEY ("KEY_ID:KEY_SECRET") or the ID + secret pair
HF_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional model overrides (OpenRouter / fal model ids)
TEXT_MODEL=anthropic/claude-sonnet-5.5
VISION_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=google/gemini-nano-banana-2.1
VIDEO_MODEL=bytedance/seedance-2.0-fast
# SCRIPT_WRITER_MODEL=google/gemini-4-carbon   # optional: default Script Lab writer
# SCRIPT_JUDGE_MODEL=openai/gpt-6.1-sol        # optional: default Script Lab grader
# JEV_GATES=1               # optional: cheap Jev yes/no pre-checks (OpenRouter Decisions API) before the script judge
# JEV_MODEL=typesafe/jev-1.13   # optional: pin a different Jev release
# TOURNAMENT_SIZE=2         # optional: image takes per static direction (1-4); vision QA keeps the best
# STATIC_TYPESET=off        # optional: turn off code-typeset headline/offer/logo on static ads
# SCRIPT_EVAL_FILE=         # optional: local JSON cases for `npm run eval:scripts`

# Local media QA. Tesseract with the selected language is required for video exports.
TESSERACT_BIN=/opt/homebrew/bin/tesseract
OCR_LANG=eng
# Set an absolute model path for offline speech verification and word timings. Otherwise Studio uses fal Whisper.
WHISPER_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL_PATH=~/.gtm-tools/models/ggml-base.en.bin
WHISPER_LANG=en
# Optional free tools (all fall back cleanly when missing). Defaults point at ~/.gtm-tools.
# GTM_VENV=~/.gtm-tools/venv                 # Python venv with jiwer (WER), scenedetect (cuts), whisperx, torch (SyncNet)
# WHISPERX=1                                 # use WhisperX forced alignment for word timings (downloads its model once)
# WHISPERX_MODEL=base.en
# SYNCNET_DIR=~/.gtm-tools/syncnet
# LIPSYNC_QA=1                               # SyncNet lip-sync check on UGC videos with on-camera speech
# REALESRGAN_BIN=~/.gtm-tools/bin/realesrgan-ncnn-vulkan   # HD upscale of the approved 480p take
# REALESRGAN_MODELS=~/.gtm-tools/realesrgan/models
# REALESRGAN_MODEL=realesr-animevideov3      # ~1s/frame on an M-series Mac; realesrgan-x4plus is sharper but ~25s/frame
# RIFE_BIN=~/.gtm-tools/bin/rife-ncnn-vulkan
# VIDEO_INTERPOLATE=1                        # RIFE 2x frame interpolation on upscale (can smear fast motion)

# Optional "real set": one World Labs world per storyboard + Blender camera plates. Off unless both are set.
# REAL_SET=1
# WORLDLABS_API_KEY=
# WORLDLABS_MODEL=marble-1.1
# WORLDLABS_COST_USD=1.5                     # budget reserve recorded per world (the API returns no price)
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# Stage gates: cheap judge for the research, shot-plan and continuity gates (defaults to the run's vision model)
# GATE_JUDGE_MODEL=

# Supabase. DATABASE_URL (Postgres, session pooler; use the transaction pooler :6543 on Vercel) stores app data in the
# private `gtm` schema; the service-role key stores media in the private `gtm-media` bucket. Unset = local .data store.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# DATA_DIR=.data            # optional: where the local store keeps db.json and media when Supabase is unset

# Publishing
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=              # Facebook Page the ads run from (required to create ads)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# Data sources
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUBSPOT_TOKEN=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Signals
META_PIXEL_ID=
META_CAPI_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# scripts/e2e-static.mjs only
# BASE=http://localhost:3000
