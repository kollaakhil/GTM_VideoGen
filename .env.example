# Sign-in (required)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=   # 32+ random chars, e.g. `openssl rand -hex 32`
# QA_PASS_SCORE=8

# AI & media
OPENROUTER_API_KEY=
FAL_KEY=
HIGGSFIELD_API_KEY=
# Optional model overrides (OpenRouter / fal model ids)
TEXT_MODEL=anthropic/claude-sonnet-5.5
VISION_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=google/gemini-nano-banana-2.1
VIDEO_MODEL=google/gemini-omni-1.2-flash

# Supabase (app falls back to an in-memory demo store when unset)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publishing
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# Data sources
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUBSPOT_TOKEN=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Signals
META_PIXEL_ID=
META_CAPI_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
